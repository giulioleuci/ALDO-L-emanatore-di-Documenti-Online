{
  "name": "aldo-sgsa",
  "version": "0.1.0",
  "description": "SGSA (ALDO) — school management ERP on Google Apps Script",
  "type": "module",
  "main": "dist/Code.js",
  "scripts": {
    "build": "npm run build:production",
    "build:readable": "node scripts/build-and-prepare.cjs --mode=testing",
    "watch": "webpack --watch --env readable",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit && tsc -p test/types/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config jest.config.cjs",
    "test:integration": "jest --config jest.integration.config.cjs",
    "test:build": "jest --config jest.build.config.cjs",
    "refresh:vendor": "node scripts/refresh-vendor.cjs",
    "verify:vendor": "node scripts/verify-vendor.cjs",
    "setup:testonline": "node scripts/setup-testonline-project.cjs",
    "build:testing": "node scripts/build-and-prepare.cjs --mode=online",
    "build:testoffline": "node scripts/build-and-prepare.cjs --mode=testoffline",
    "build:production": "node scripts/build-and-prepare.cjs --mode=production",
    "push:testing": "npm run build:testing && clasp push",
    "push:production": "npm run build:production && clasp push"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.39.2",
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.99",
    "@types/jest": "^30.0.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "gas-webpack-plugin": "^2.3.0",
    "globals": "^14.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^30.2.0",
    "minimizer-webpack-plugin": "^5.6.1",
    "prettier": "^3.7.4",
    "source-map": "^0.7.6",
    "terser": "^5.48.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
